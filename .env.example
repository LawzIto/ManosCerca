# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase
# (Dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# URL pública de la app; se usa en los enlaces de los correos de Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push: clave pública VAPID (la privada va en los secretos de la Edge Function send-push).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
